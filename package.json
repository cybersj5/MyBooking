{
  "name": "mybooking",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "24.21.0",
    "npm": "12.2.0"
  },
  "workspaces": [
    "contract",
    "server",
    "web",
    "e2e"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "build": "npm run build --workspaces",
    "format:check": "prettier --check package.json eslint.config.mjs tsconfig.base.json contract server web e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
