# Адрес и порт сервера.
MYBOOKING_HOST=127.0.0.1
MYBOOKING_PORT=3000

# Путь к SQLite. Родительская директория создаётся при первом запуске.
MYBOOKING_DB_PATH=./data/mybooking.db

# Разрешённые Origin для CORS и CSRF-проверки. Через запятую, без пробелов вокруг значений.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173

# Секреты. Должны быть заданы, иначе сервер не стартует.
MYBOOKING_HMAC_SECRET=dev-only-change-me
MYBOOKING_SYSTEM_KEY=dev-only-change-me

# Текущая версия согласия на обработку персональных данных.
MYBOOKING_CONSENT_VERSION=1

# Контакт для удаления данных.
MYBOOKING_DELETION_CONTACT=delete@example.com

# Включать Secure на cookie (0 для локальной разработки, 1 для продакшена).
MYBOOKING_SECURE_COOKIES=0

# Режим почты. Если GMAIL_USER не задан и эта переменная равна 1,
# одноразовые коды пишутся в stderr (только для локальной разработки).
MYBOOKING_DEV_MAIL_LOG=0

# Параметры Gmail SMTP. Пустые значения принимаются только в режиме
# MYBOOKING_DEV_MAIL_LOG=1; в продакшене нужно заполнить все три.
GMAIL_USER=eljoy1337@gmail.com
GMAIL_APP_PASSWORD=tymy thfl nvvi ameu
MAIL_FROM=eljoy1337@gmail.com
